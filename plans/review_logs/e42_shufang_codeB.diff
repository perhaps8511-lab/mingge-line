+/* 閱讀頁逐段 DOM:僅古文 span 包引文卡,其餘 createTextNode;零改字零 innerHTML(R1-#10) */
+function studyParagraph(line){
+  var p=document.createElement('p');
+  var idx=0,guard=0;
+  while(idx<line.length && guard++<300){
+    var seg=line.slice(idx);
+    var m=seg.match(STUDY_QUOTE_RE);
+    if(!m){ p.appendChild(document.createTextNode(line.slice(idx))); return p; }
+    var q=m[1];
+    var qStart=idx+m.index+m[0].length-q.length;
+    if(qStart>idx){ p.appendChild(document.createTextNode(line.slice(idx,qStart))); }
+    var span=document.createElement('span'); span.className='study-quote';
+    span.appendChild(document.createTextNode(q));
+    p.appendChild(span);
+    idx=qStart+q.length;
+  }
+  if(idx<line.length){ p.appendChild(document.createTextNode(line.slice(idx))); }
+  return p;
+}

+/* 一句引:精確匹配樣板才剝→取次句→≤20+「…」(Perth §10-A;禁 AI;主體逐字取自 body) */
+function studyYiju(body){
+  var b=(body||'').replace(/^\s+/,'');
+  var m=b.match(/^老易在書房[，,](?:談|寫於)[^。]*。/);
+  var rest=m?b.slice(m[0].length).replace(/^\s+/,''):b;
+  var sm=rest.match(/^[^。！？\n]*[。！？]/);
+  var s=(sm?sm[0]:(rest.split('\n')[0]||'')).replace(/\s+$/,'');
+  return s.length>20 ? s.slice(0,20)+'…' : s;
+}
